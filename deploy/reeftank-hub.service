[Unit]
Description=ReefTank Hub aquarium controller
Documentation=https://github.com/cp296944/reeftank-hub
Wants=network-online.target
After=network-online.target
# If the process keeps failing right after an update, hand off to the rollback unit.
OnFailure=reeftank-hub-rollback.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=reefhub
Group=reefhub
ExecStart=/opt/reeftank-hub/current/reeftank-hub --config /opt/reeftank-hub/data/config.json
Restart=on-failure
RestartSec=3

# Let the non-root service bind :80 and restart itself after an OTA swap.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# systemctl restart of THIS unit is allowed via the polkit rule in deploy/.

# Hardening (kept mild - it still needs outbound HTTPS + LAN + wlan0).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/reeftank-hub
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
