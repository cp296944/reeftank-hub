[Unit]
Description=ReefTank Hub aquarium controller
Documentation=https://github.com/cp296944/reeftank-hub
Wants=network-online.target
After=network-online.target
OnFailure=reeftank-hub-rollback.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=reefhub
Group=reefhub
EnvironmentFile=-/etc/reeftank-hub/ha.env
ExecStart=/opt/reeftank-hub/current/reeftank-hub --config /opt/reeftank-hub/data/config.json
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/reeftank-hub
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
