// Permit only the ReefTank Hub service account to start five fixed Thread
// maintenance units. No arbitrary unit name or verb is accepted.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units" ||
        subject.user != "reefhub" || action.lookup("verb") != "start") return;
    var unit = action.lookup("unit");
    if (unit == "reeftank-thread-flash.service" ||
        unit == "reeftank-thread-install.service" ||
        unit == "reeftank-thread-restart.service" ||
        unit == "reeftank-thread-dataset.service" ||
        unit == "reeftank-thread-rollback.service") return polkit.Result.YES;
});
