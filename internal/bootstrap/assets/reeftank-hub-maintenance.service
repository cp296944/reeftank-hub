[Unit]
Description=ReefTank Hub privileged maintenance gate
Documentation=https://github.com/cp296944/reeftank-hub
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/reeftank-hub-maintainer maintenance apply --request /opt/reeftank-hub/state/maintenance-request.json
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/reeftank-hub /etc/systemd/system /etc/polkit-1/rules.d /etc/dbus-1/system.d /usr/local/libexec
